# Specifies the port the backend server will listen on
# Accessed in server/src/server.js
PORT=3001

# Your secret API key for authenticating with the OpenAI service
# Accessed in server/src/services/llmService.js
# IMPORTANT: Replace placeholder with your actual key and keep this file secure!
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# Secret key clients must send via the X-Api-Key header to call /api/generate
# Accessed in server/src/routes/generate.route.js
APP_API_KEY="YOUR_APP_API_KEY_HERE"